// ==== Live Script Copilot · 后端运行配置 ====
// 复制本文件为 .env 后按需修改。切勿把真实密钥提交到 Git。

NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173

# ---- 安全 ----
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=2h

# ---- 数据 ----
DATABASE_URL=./data/app.db

# ---- LLM（默认 DeepSeek，OpenAI 兼容协议，可切任意兼容厂商）----
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=120
LLM_TOP_P=0.95
LLM_TIMEOUT_MS=8000

# ---- 语义切片 与 生成节流 ----
SLICER_SILENCE_MS=350
SLICER_MAX_PENDING_MS=2500
# 最小触发字数：直播场景短句多（如"包邮吗""便宜点呗"），建议 3~4，
# 调高可省成本但会漏掉短提问，调低则更灵敏（靠去重/节流兜住重复调用）
SLICER_MIN_CHARS=4
GEN_MIN_INTERVAL_MS=1200
GEN_DEDUP_MS=3000

# ---- WebSocket ----
WS_HEARTBEAT_MS=15000
WS_TIMEOUT_MS=45000

# ---- 降级开关（运维可在紧急情况下通过环境变量关闭生成能力）----
# FEATURE_GENERATE=off 时只做转写，不调用 LLM
FEATURE_GENERATE=on
# 单主播单场 LLM 调用上限，超出后降级为模板话术，做成本熔断
MAX_LLM_CALLS_PER_SESSION=400

# ---- 声纹（说话人识别：提前录入主播声音，直播时区分主播/对方）----
# 后端：auto 自动探测 wespeaker（需 torch+模型，生产推荐）/ 否则用纯 numpy MFCC 基线
VOICEPRINT_BACKEND=auto
# 判定为「主播本人」的余弦相似度阈值（MFCC 基线区分度有限，生产请换 wespeaker 后按需调）
VOICEPRINT_HOST_THRESHOLD=0.80
# 直播时向服务端推送 PCM 的切片时长（毫秒）
VOICEPRINT_CHUNK_MS=1000
